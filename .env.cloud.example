# Copy to .env.cloud and replace every value. Never commit .env.cloud.
# Find these values in your Grafana Cloud stack's OpenTelemetry connection details.
# Use the HTTPS base OTLP endpoint ending in /otlp, not a /v1 signal URL.
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_INSTANCE_ID=
# Store only the token, with no trailing newline, in this ignored file.
GRAFANA_CLOUD_API_KEY_FILE=./secrets/grafana-cloud-api-key.txt

# Resource identity sent by the sample application.
OTEL_SERVICE_NAME=checkout-api
OTEL_RESOURCE_ATTRIBUTES=service.namespace=otel-onboarding,deployment.environment.name=demo,service.version=1.0.0,grafana.host.id=otel-onboarding-demo-host
LOADGEN_REQUESTS=20
LOADGEN_INTERVAL_MS=1500
