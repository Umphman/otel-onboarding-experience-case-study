# Local demo defaults. No credentials are required for the local LGTM stack.
OTEL_SERVICE_NAME=checkout-api
OTEL_RESOURCE_ATTRIBUTES=service.namespace=otel-onboarding,deployment.environment.name=local,service.version=1.0.0
OTEL_NODE_RESOURCE_DETECTORS=env,host,os,serviceinstance
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
# Host-local default. Compose supplies http://alloy:4318 inside its network.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_LOG_LEVEL=info
OTEL_METRIC_EXPORT_INTERVAL=5000
PORT=8080
LOADGEN_INTERVAL_MS=1500
